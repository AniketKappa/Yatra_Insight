{
  "name": "yatra-insight",
  "version": "1.0.0",
  "private": true,
  "description": "LLM-powered project monitoring and decision support for tourism infrastructure projects",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts --port=8787",
    "dev:web": "node scripts/build-styles.mjs && vite --config web/vite.config.ts",
    "build": "node scripts/build-styles.mjs && vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "seed": "node server/seed-cli.ts",
    "test": "node --test --test-reporter=spec \"server/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "tokens": "node scripts/build-styles.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
