# Copy to .env and fill in. Without a key the app runs in offline analysis mode.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=on         # set to "off" to disable server-side refusal fallbacks
# PORT=8787
# AS_OF_DATE=2026-11-16          # pin "today" for demos
