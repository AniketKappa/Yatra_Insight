# Copy to .env and fill in. Without a key the app runs in offline analysis mode.
GROQ_API_KEY=
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b      # any Groq chat model with tool use, e.g. llama-3.3-70b-versatile
# GROQ_REASONING_EFFORT=medium        # low | medium | high (reasoning models such as gpt-oss only)
# PORT=8787
# AS_OF_DATE=2026-11-16               # pin "today" for demos
